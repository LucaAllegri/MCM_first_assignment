clc, clearvars, close all
addpath('include');
%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PUNTO 1.1  Angle-axis to rot
%%%%%%%%%%%%%%%%%%%%%%%%%%%%
disp("%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%");
disp("PUNTO 1.1 Angle-axis to rot");
disp("%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%");

disp("----------------------------------------");
disp("1.1.1")
disp("----------------------------------------");
theta = deg2rad(90);

h = [1,0,0];

R = AngleAxisToRot(h,theta);
disp (R);

disp("----------------------------------------");
disp("1.1.2")
disp("----------------------------------------");

theta = deg2rad(60);

h = [0,0,1];

R = AngleAxisToRot(h,theta);
disp (R);

disp("----------------------------------------");
disp("1.1.3")
disp("----------------------------------------");

rho = [-pi/3, -pi/6, pi/3];

theta = sqrt(rho(1,1)^2 + rho(1,2)^2 + rho(1,3)^2);

h = rho / theta;   % RHO P= PI/3 PI/6 PI/3

R = AngleAxisToRot(h,theta);
disp(theta);
disp(h);
disp (R);

%%NORMA DI RHO è THETA   

