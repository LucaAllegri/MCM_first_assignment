disp("----------------------------------------");

R = [1 0 0;
     0 0 -1;
     0 1 0];

[psi, theta, phi] = RotToYPR(R);

disp("display psi:")
disp(psi);
disp("display theta:")
disp(theta);
disp("display phi:")
disp(phi);

disp("----------------------------------------");
disp("1.4.2")
disp("----------------------------------------");


R = [1/2        -sqrt(3)/2    0;
     sqrt(3)/2       1/2      0;
     0                0       1];

[psi, theta, phi] = RotToYPR(R);

disp("display psi:")
disp(psi);
disp("display theta:")
disp(theta);
disp("display phi:")
disp(phi);

disp("----------------------------------------");
disp("1.4.3")
disp("----------------------------------------");


R = [    0             -sqrt(2)/2            sqrt(2)/2;
        1/2        sqrt(2)*sqrt(3)/4     sqrt(2)*sqrt(3)/4;
     -sqrt(3)/2         sqrt(2)/4            sqrt(2)/4];

[psi, theta, phi] = RotToYPR(R);

disp("display psi:")
disp(psi);
disp("display theta:")
disp(theta);
disp("display phi:")
disp(phi);


disp("----------------------------------------");

%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PUNTO 1.5    Rot to angle-axis with eigenvectors
%%%%%%%%%%%%%%%%%%%%%%%%%%%%

disp("%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%");
disp("PUNTO 1.5  Rot to angle-axis with eigenvectors");
disp("%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%");

disp("----------------------------------------");
disp("1.5.1")
disp("----------------------------------------");

R = [1 0 0;
     0 0 -1;
     0 1 0];
is_rot = IsRotationMatrix(R);

if is_rot
    [h,theta] = RotToAngleAxis(R);
    disp("Primo metodo");
    disp("h:");
    disp(h);
    disp("theta:");
    disp(rad2deg(theta));
    
    disp("Secondo metodo");
    h = eigein_H(R);
    disp("h: ");
    disp(h);
    [~,theta] = RotToAngleAxis(R);
    disp("theta:");
    disp(rad2deg(theta));
else 
    disp("NOT A ROTATION MATRIX")
end


disp("----------------------------------------");
disp("1.5.2")
disp("----------------------------------------");

R = (1/9) * [-4 -4 -7;
              8  1  4;
             -1 -8  4];

is_rot = IsRotationMatrix(R);

if is_rot
    [h,theta] = RotToAngleAxis(R);
    disp("Primo metodo");
    disp("h:");
    disp(h);
    disp("theta deg:");
    disp(rad2deg(theta));
    disp("theta rad:");
    disp(theta);
    
    disp("Secondo metodo");
    h = eigein_H(R);
    disp("h: ");
    disp(h);
    [~,theta] = RotToAngleAxis(R);
    disp("theta deg:");
    disp(rad2deg(theta));
    disp("theta rad:");
    disp(theta);
else 
    disp("NOT A ROTATION MATRIX")
end


function [h] = eigein_H(R)
    [eigVec, eigVal] = eig(R);
    D = diag(eigVal);
    ind = -1;
    for i = 1:length(D)
        if(abs(D(i) - 1) < 10^-3)
            ind = i;
        end
    end
    h = eigVec(:,ind);  
end