function [h,theta] = RotToAngleAxis(R)


    bool isRotatioisRotationMatrix(R);
 
    for i=1:length(R)
        for j=1:length(R)
            RT(j,i) = R(i,j);
        end
    end

    % TRACE'S COMPUTE
    trace = 0;
    i=1; j=1;
    for n=1:length(R)
        trace = trace + R(i, j); 
        i=i+1;
        j=j+1;
    end
    disp("Trace:");
    disp(trace);
    theta = 1/cos(trace-1/2);

    % if 0<theta<pi
    % 
    % end

    % h-VECTOR'S COMPUTE

    diff_R_RT = R - RT;
    axial_vector = vex(diff_R_RT/2);

    if theta == 0
        %null rotation so h is arbitrary
        disp("0");
        h = [1; 0; 0]; % Arbitrary unit vector for null rotation
    elseif pi-0,02 <= theta <= pi+0,02;  %AGGIUNGERE LA TOLLERANZA 10-3
        hx = sqrt((R(1,1) + 1)/2);
    %TO DO HY HZ CON CONVENZIONE DEL SEGNO POSITIVO 
        %h = [hx hy hz];
        h = [1; 0; 0]; % a caso per restituire qualcosa prima di cambiare
        disp("pi");
    else
        h = (1 / sin(theta)) * axial_vector ;
        disp("tra 0 e pi");
    end

end


function a = vex(S_a)
    a = [S_a(3,2) S_a(1,3) S_a(2,1)];
end